  "evidence": [
    {
      "id": "replication-psychology",
      "category": "reliability",
      "evidenceType": "Peer-reviewed coordinated replication study",
      "observation": "A coordinated project repeated 100 experimental and correlational studies from three psychology journals; 36% of replications produced statistically significant results.",
      "interpretation": "Reliability cannot be inferred from publication volume. This result concerns sampled psychology studies, not all science.",
      "caveat": "Replication success depends on definitions, power, design fidelity and field context.",
      "sourceId": "osc-2015"
    },
    {
      "id": "alphafold-casp14",
      "category": "demonstrated acceleration",
      "evidenceType": "Peer-reviewed benchmark validation",
      "observation": "On 87 CASP14 protein domains, AlphaFold achieved median backbone error of 0.96 Å versus 2.8 Å for the next-best method.",
      "interpretation": "AI produced a demonstrated capability jump for protein-structure prediction.",
      "caveat": "Prediction is not experimental confirmation, biological understanding, a drug candidate, or clinical benefit.",
      "sourceId": "alphafold-2021"
    },
    {
      "id": "open-science",
      "category": "reliability",
      "evidenceType": "International normative framework",
      "observation": "UNESCO's 2021 Recommendation includes open publications, research data, software and source code within open scientific knowledge.",
      "interpretation": "Inspectable data and software can lower verification and reuse friction.",
      "caveat": "A recommendation records a standard, not adoption or causal impact.",
      "sourceId": "unesco-open-science"
    },
    {
      "id": "clinical-gates",
      "category": "translation",
      "evidenceType": "Regulatory process",
      "observation": "FDA separates drug development into discovery, preclinical research, clinical research, review and post-market monitoring.",
      "interpretation": "Faster discovery does not remove safety, efficacy and review requirements.",
      "caveat": "FDA describes the United States and medical products; other jurisdictions and research outputs differ.",
      "sourceId": "fda-drug-process"
    }
  ],
  "rivalExplanations": [
    "Higher article counts can reflect more researchers, indexing coverage, collaboration and publication incentives rather than faster discovery.",
    "Higher R&D intensity can expand capacity while costs, complexity or regulatory safeguards lengthen translation.",
    "AI can accelerate bounded tasks while validation, data quality, wet-lab work and implementation remain bottlenecks."
  ],
  "reversalIndicators": [
    "Multi-field evidence that time from hypothesis to independently replicated result is falling without weaker standards.",
    "Cohort evidence that clinical development stages shorten while safety and efficacy outcomes hold or improve.",
    "Repeated randomized or benchmarked studies showing AI gains transfer from task performance to validated discoveries.",
    "Widening access to research capacity, data and software rather than gains concentrated in few institutions."
  ],
  "possibilities": [
    {
      "label": "Hypothesis",
      "text": "AI may compress search and modelling while moving the bottleneck to validation and implementation."
    },
    {
      "label": "Possibility",
      "text": "Open data and research software may compound discovery by making results easier to inspect and reuse."
    },
    {
      "label": "Data gap",
      "text": "No comparable global series measures time from idea to reliable, adopted discovery across fields."
    }
  ],
