---
import ProjectDetails from '../../components/ProjectDetails.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import '../../styles/portfolio.css';

const orderedProjects = [...projects].sort((a, b) => b.date.localeCompare(a.date));
---
<SiteLayout
  title="Work — CTW Studio"
  description="CTW Studio portfolio of research software and independent product experiments."
  canonical="/portfolio/"
  current="portfolio"
>
  <main id="main-content" class="portfolio-page">
    <div class="ctw-container">
      <header class="portfolio-lead">
        <p class="ctw-section-number">Work / 2013–2026</p>
        <h1>Software and design work.</h1>
        <div class="portfolio-lead__meta">
          <span>{orderedProjects.length} projects</span>
          <span>Based in Amsterdam</span>
        </div>
      </header>
      <ProjectGrid projects={orderedProjects} />
      <ProjectDetails projects={orderedProjects} />
    </div>
  </main>
  <script src="../../scripts/portfolio-controller.ts"></script>
</SiteLayout>
