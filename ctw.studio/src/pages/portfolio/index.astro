---
import ProjectDetails from '../../components/ProjectDetails.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import '../../styles/portfolio.css';

const orderedProjects = [...projects].sort((a, b) =>
  Number(b.id === 'droneatlas') - Number(a.id === 'droneatlas') || b.date.localeCompare(a.date)
);
---
<SiteLayout
  title="Work — Jessie Gonzalez"
  description="Selected interaction design engineering and software work by Jessie Gonzalez across research, culture, and independent products."
  canonical="/portfolio/"
  current="portfolio"
>
  <main id="main-content" class="portfolio-page">
    <div class="ctw-container">
      <header class="portfolio-lead">
        <p class="ctw-section-number">Selected work</p>
        <h1>Complex work,<br />made usable.</h1>
        <p class="portfolio-lead__intro">From archaeological maps to research tools and independent products: I design the interaction and build the system behind it.</p>
        <div class="portfolio-lead__meta">
          <span>{orderedProjects.length} projects, selected from my practice</span>
          <a href="https://github.com/ctwhome" target="_blank" rel="noopener noreferrer">Explore code on GitHub ↗</a>
        </div>
      </header>
      <ProjectGrid projects={orderedProjects} />
      <ProjectDetails projects={orderedProjects} />
    </div>
  </main>
  <script src="../../scripts/portfolio-controller.ts"></script>
</SiteLayout>
