---
import type { Project } from '../data/projects';

interface Props {
  projects: readonly Project[];
}

const { projects } = Astro.props;
const coverUrl = (id: string, width: number) => `/portfolio/covers/${id}-${width}.webp`;
---
<ol class="portfolio-grid" aria-label="Selected projects">
  {projects.map((project, index) => (
    <li class="project-card">
      <a
        class="project-card__link"
        href={`#${project.id}`}
        data-project-link={project.id}
        aria-haspopup="dialog"
      >
        <span class="project-card__media">
          <img
            class="project-card__image"
            src={coverUrl(project.id, 960)}
            srcset={`${coverUrl(project.id, 480)} 480w, ${coverUrl(project.id, 720)} 720w, ${coverUrl(project.id, 960)} 960w`}
            sizes="(max-width: 48rem) calc(100vw - 2rem), calc((min(100vw - 2rem, 75rem) - clamp(1.5rem, 3vw, 3rem)) / 2)"
            alt=""
            width="960"
            height="640"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding={index === 0 ? 'sync' : 'async'}
          />
        </span>
        <span class="project-card__copy">
          <span class="project-card__meta">
            <span>{project.category} · {new Date(project.date).getUTCFullYear()}</span>
            <span class="project-card__index">{String(index + 1).padStart(2, '0')}</span>
          </span>
          <span class="project-card__title">
            <strong>{project.title}</strong>
            <span class="project-card__arrow" aria-hidden="true">↗</span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ol>
