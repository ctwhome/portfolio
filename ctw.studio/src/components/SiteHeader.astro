---
interface Props {
  current?: 'home' | 'portfolio' | 'signals' | 'workshop';
}

const { current } = Astro.props;
---
<header class="ctw-masthead">
  <div class="ctw-container ctw-masthead__inner">
    <a
      class="ctw-wordmark"
      href="/"
      aria-current={current === 'home' ? 'page' : undefined}
    >CTW Studio</a>
    <nav class="ctw-primary-nav" aria-label="Primary navigation">
      <a class="ctw-primary-nav__link" href="/portfolio/" aria-current={current === 'portfolio' ? 'page' : undefined}>Projects</a>
      <a class="ctw-primary-nav__link" href="/signals/" aria-current={current === 'signals' ? 'page' : undefined}>Signals</a>
      <a class="ctw-primary-nav__link" href="/nlesc/">NLeSC</a>
      <a class="ctw-primary-nav__link" href="/workshop/" aria-current={current === 'workshop' ? 'page' : undefined}>Workshop</a>
      <a class="ctw-primary-nav__link" href="/#contact">Contact</a>
    </nav>
  </div>
</header>
