---
interface Props {
  current?: 'home' | 'portfolio' | 'writing' | 'signals' | 'workshop';
}

const { current } = Astro.props;
---
<header class="ctw-masthead ctw-masthead--studio">
  <div class="ctw-container ctw-masthead__inner">
    <a
      class="ctw-wordmark"
      href="/"
      aria-current={current === 'home' ? 'page' : undefined}
      aria-label="Jesse Gonzalez, home"
    ><span class="ctw-wordmark__label" aria-hidden="true"><span class="ctw-wordmark__full">Jesse Gonzalez</span><span class="ctw-wordmark__compact">JG</span><span class="ctw-wordmark__dot">.</span></span></a>
    <nav class="ctw-primary-nav" aria-label="Primary navigation">
      <a class="ctw-primary-nav__link" href="/portfolio/" aria-current={current === 'portfolio' ? 'page' : undefined}>Work</a>
      <a class="ctw-primary-nav__link" href="/writing/" aria-current={current === 'writing' ? 'page' : undefined}>Writing</a>
      <a class="ctw-primary-nav__link" href="/signals/" aria-current={current === 'signals' ? 'page' : undefined}>Signals</a>
      <a class="ctw-primary-nav__link ctw-primary-nav__link--stand-out" href="/stand-out/" aria-label="Stand Out">Stand Out</a>
      <a
        class="ctw-primary-nav__link ctw-liquid-contact"
        href="/#about"
        aria-label="Contact"
        data-liquid-contact
        data-liquid-mode="static"
        data-liquid-active="false"
        data-liquid-pressing="false"
        data-liquid-x="50"
        data-liquid-y="50"
        draggable="false"
      >
        <canvas class="ctw-liquid-contact__canvas" aria-hidden="true"></canvas>
        <span class="ctw-liquid-contact__rim" aria-hidden="true"></span>
        <span class="ctw-liquid-contact__surface" aria-hidden="true"></span>
        <span class="ctw-liquid-contact__ripple" aria-hidden="true"></span>
        <svg class="ctw-liquid-contact__plus" viewBox="0 0 115 115" aria-hidden="true">
          <g stroke="currentColor" stroke-width="17" stroke-linecap="round">
            <path d="M57.5 8.5 V106.5" />
            <path d="M8.5 57.5 H106.5" />
          </g>
        </svg>
        <span class="ctw-liquid-contact__label">Contact</span>
      </a>
    </nav>
  </div>
</header>

<script>
  import { mountLiquidContacts } from '../scripts/liquid-contact';
  mountLiquidContacts();
</script>
