---
import type { Project } from '../data/projects';

interface Props {
  projects: readonly Project[];
}

const { projects } = Astro.props;
const mediaUrl = (path: string) => `/portfolio/${path}`;
---
<div class="project-details">
  {projects.map((project, index) => {
    const next = projects[(index + 1) % projects.length];
    return (
      <dialog
        class="project-dialog"
        id={project.id}
        data-project-dialog={project.id}
        aria-labelledby={`${project.id}-title`}
      >
        <header class="project-dialog__header">
          <p class="ctw-label">{project.category} / {new Date(project.date).getUTCFullYear()}</p>
          <form method="dialog">
            <button class="project-dialog__close" value="close" aria-label={`Close ${project.title}`}>Close ×</button>
          </form>
        </header>

        <div class="project-dialog__body">
          <div class="project-dialog__lead">
            <p class="ctw-section-number">{String(index + 1).padStart(2, '0')} / Project</p>
            <h2 class="project-dialog__title" id={`${project.id}-title`}>{project.title}</h2>
            <p class="project-dialog__headline">{project.headline}</p>
          </div>

          <div class="project-dialog__narrative">
            {project.description.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <dl class="project-dialog__facts">
            <div><dt>Client</dt><dd>{project.client}</dd></div>
            {project.institution && <div><dt>Institution</dt><dd>{project.institution}</dd></div>}
            <div><dt>Methods</dt><dd>{project.tags.join(' · ')}</dd></div>
          </dl>

          {(project.liveUrl || project.repoUrl || project.pdfUrl) && (
            <nav class="project-dialog__links" aria-label={`${project.title} links`}>
              {project.liveUrl && <a class="ctw-button" href={project.liveUrl} target={project.liveUrl.startsWith('/') ? undefined : '_blank'} rel={project.liveUrl.startsWith('/') ? undefined : 'noopener noreferrer'}>Visit project ↗</a>}
              {project.repoUrl && <a class="ctw-button ctw-button--secondary" href={project.repoUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>}
              {project.pdfUrl && <a class="ctw-button ctw-button--secondary" href={mediaUrl(project.pdfUrl)} target="_blank" rel="noopener noreferrer">Read PDF ↗</a>}
            </nav>
          )}

          {project.gallery.length > 0 && (
            <div class="project-gallery" aria-label={`${project.title} gallery`}>
              {project.gallery.map((item) => (
                item.type === 'video' ? (
                  <figure class="project-gallery__item">
                    <video controls playsinline preload="none" width="1600" height="900">
                      <source data-src={mediaUrl(item.src)} type="video/mp4" />
                    </video>
                    <noscript><a class="project-gallery__source" href={mediaUrl(item.src)}>Open original video</a></noscript>
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                ) : item.type === 'pair' ? (
                  <figure class="project-gallery__item project-gallery__item--pair">
                    <div>
                      <img data-src={mediaUrl(item.src)} alt="" width="1600" height="900" decoding="async" />
                      <img data-src={mediaUrl(item.src2)} alt="" width="1600" height="900" decoding="async" />
                    </div>
                    <noscript>
                      <p class="project-gallery__source">
                        <a href={mediaUrl(item.src)}>Open first original image</a>
                        {' · '}
                        <a href={mediaUrl(item.src2)}>Open second original image</a>
                      </p>
                    </noscript>
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                ) : (
                  <figure class="project-gallery__item">
                    <img data-src={mediaUrl(item.src)} alt={item.caption ?? ''} width="1600" height="900" decoding="async" />
                    <noscript><a class="project-gallery__source" href={mediaUrl(item.src)}>Open original image</a></noscript>
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                )
              ))}
            </div>
          )}

          <a class="project-next" href={`#${next.id}`} data-project-link={next.id}>
            <span class="ctw-label">Next project</span>
            <strong>{next.title} →</strong>
          </a>
        </div>
      </dialog>
    );
  })}
</div>
