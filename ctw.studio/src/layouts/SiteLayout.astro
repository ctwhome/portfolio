---
import DocumentHead from '../components/DocumentHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  current?: 'home' | 'portfolio' | 'writing';
  ogDescription?: string;
  ogType?: 'article' | 'website';
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  articleAuthor?: string;
  publishedTime?: string;
  bodyClass?: string;
  homepageStyles?: boolean;
}

const {
  title,
  description,
  canonical,
  current,
  ogDescription = description,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  articleAuthor,
  publishedTime,
  bodyClass = '',
  homepageStyles = false
} = Astro.props;
---
<!doctype html>
<html lang="en" class="ctw-theme-coal">
  <head>
    <DocumentHead
      title={title}
      description={description}
      canonical={canonical}
      ogDescription={ogDescription}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      articleAuthor={articleAuthor}
      publishedTime={publishedTime}
      homepageStyles={homepageStyles}
    />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const stored = localStorage.getItem('ctw-motion-preference');
          if (stored === 'full' || stored === 'reduced') preference = stored;
        } catch {}
        document.documentElement.dataset.motionPreference = preference;
      })();
    </script>
  </head>
  <body class:list={['ctw-scope', bodyClass]}>
    <a class="ctw-skip-link" href="#main-content">Skip to content</a>
    <div class="ctw-shell ctw-shell--site">
      <SiteHeader current={current} />
      <slot />
      <SiteFooter />
    </div>
    <script is:inline src="/feedback.js"></script>
  </body>
</html>
