---
import DocumentHead from '../components/DocumentHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WorkshopFooter from '../components/WorkshopFooter.astro';
import '../styles/fonts.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogDescription?: string;
  legal?: boolean;
}

const { title, description, canonical, ogDescription = description, legal = false } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth" style="background:#000">
  <head>
    <DocumentHead
      title={title}
      description={description}
      canonical={canonical}
      ogDescription={ogDescription}
      pageCssUrls={['/tailwind.css']}
      transitions={false}
    />
    <style is:global>
      :root { color-scheme: dark; }
      html { scrollbar-gutter: stable; }
      body {
        margin: 0;
        font-family: 'Inter Variable', Inter, system-ui, sans-serif;
        background-color: #000;
        color: #f2f1ec;
        line-height: 1.7;
      }
      .tag { letter-spacing: .25em; font-size: .65rem; }
      .workshop-back-link { min-height: 44px; }
      .scroll-card {
        background: rgba(8, 8, 8, .75);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 24px;
        padding: 2rem;
        transition: transform .2s ease, border-color .2s ease;
      }
      .scroll-card:hover { transform: translateY(-4px); border-color: rgba(247, 181, 0, .4); }
      .faq-question {
        min-height: 44px;
        list-style: none;
      }
      .faq-question::-webkit-details-marker { display: none; }
      .faq-question::marker { content: ""; }
      .faq-question:focus-visible { outline: 2px solid #f7b500; outline-offset: 3px; }
      .faq-item[open] .faq-icon { transform: rotate(45deg); }
      .faq-icon { transition: transform .3s ease; }
      .glitch { position: relative; display: inline-block; cursor: default; }
      .glitch::before,
      .glitch::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        background: #000;
        clip-path: inset(0 0 100% 0);
      }
      .glitch::before { color: #0ff; text-shadow: 1px 0 #0ff; }
      .glitch::after { color: #f0a; text-shadow: -1px 0 #f0a; }
      .glitch.intro::before,
      .glitch:hover::before { animation: glitch-1 .7s 1 linear; }
      .glitch.intro::after,
      .glitch:hover::after { animation: glitch-2 .7s 1 linear; }
      @keyframes glitch-1 {
        0%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); }
        25% { clip-path: inset(60% -3px 10% 0); transform: translate(5px, 1px); }
        50% { clip-path: inset(45% -3px 20% 0); transform: translate(4px, -1px); }
        75% { clip-path: inset(25% -3px 50% 0); transform: translate(3px, -1px); }
      }
      @keyframes glitch-2 {
        0%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); }
        25% { clip-path: inset(10% -3px 60% 0); transform: translate(-5px, -1px); }
        50% { clip-path: inset(20% -3px 50% 0); transform: translate(-4px, -1px); }
        75% { clip-path: inset(35% -3px 35% 0); transform: translate(-3px, -1px); }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto !important; }
        *, *::before, *::after {
          animation: none !important;
          scroll-behavior: auto !important;
          transition-duration: .01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="ctw-skip-link" href="#main-content">Skip to content</a>
    <div class="ctw-scope"><SiteHeader current="workshop" /></div>
    <slot />
    <WorkshopFooter legal={legal} />
  </body>
</html>
